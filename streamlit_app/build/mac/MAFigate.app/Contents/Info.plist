<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleExecutable</key>
    <string>launch.sh</string>
    <key>CFBundleIdentifier</key>
    <string>com.variantalker.mafigate</string>
    <key>CFBundleName</key>
    <string>MAFigate</string>
    <key>CFBundleDisplayName</key>
    <string>MAFigate</string>
    <!-- Both keys are placeholders, replaced by build_dmg.sh from config/constants.py's
         APP_VERSION (issue #260). They held a hardcoded version a whole major number below
         what the app itself reported, so Get Info and the About dialog disagreed about the
         same build. The build fails if a placeholder survives into the shipped bundle, so
         this template can never be the version anyone sees. -->
    <key>CFBundleVersion</key>
    <string>__APP_VERSION__</string>
    <key>CFBundleShortVersionString</key>
    <string>__APP_VERSION__</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleSignature</key>
    <string>MAFG</string>
    <key>CFBundleIconFile</key>
    <string>icon.icns</string>
    <key>LSMinimumSystemVersion</key>
    <string>10.15</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.medical</string>
    <key>CFBundleDocumentTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeName</key>
            <string>MAF File</string>
            <key>CFBundleTypeExtensions</key>
            <array>
                <string>maf</string>
            </array>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
        </dict>
    </array>
</dict>
</plist>
