/**************************** Basic parameters ****************************/
params {

    // input output
    input                      = null
    outdir                     = null

    // analysis
    analysis                   = "annotation" // type of analysis: annotation or biomarkers (plural — main.nf accepts nothing else). If not defined, annotation is used

    // references
    build                      = "hg38" // hg19 or hg38
    fasta                      = "" // genome fasta file
    pipeline                   = "dragen" // dragen, sarek and iontorrent available.
    target                     = "" // target file, if whole genome, put a bed file with chromosome, start end (e.g. chr1 1 248956422)
    projectid                  = "test"
    chunk_size                 = 10000
    
    // Boilerplate options
    publish_dir_mode           = "copy"
    email                      = null
    email_on_fail              = null
    plaintext_email            = false
    monochrome_logs            = false
    hook_url                   = null
    help                       = false
    version                    = false
    validate_params            = true
    show_hidden_params         = false
    schema_ignore_params       = "classifyCNV_folder,renovo_path,classify-CNV_folder,genomes"




    /**************************** Annotation input file ****************************/
   
    // Funcotator params
    transcript_selection = "CANONICAL"
    funcotator_target = "null" // Target file for funcotator. Recommendation: keep it null if variant calling has been done with target file.
    target_padding = 2 // set to a number so that we do not have problems with 0 or 1 starting bins (e.g. 2)
    splice_site_window_size = 2 // Number of bases on either side of a splice site for a variant to be classified as a SPLICE_SITE variant.

    funcotator_ncores         = 1 // number of cores to use for funcotator annotation. If you have a lot of variants, you can increase this number to speed up the annotation. If you have a small number of variants, you can decrease this number to save resources. Note that this is not the number of cores used for the whole pipeline, but only for the funcotator annotation step. The pipeline will automatically split the variants into chunks and run them in parallel.
    funcotator_somatic_db = null
    funcotator_germline_db = null
    annovar_db = null
    annovar_software_folder = null
    transcript_list = null

    // Annovar funcotator databases
    database_dir = "${projectDir}/resources/databases"

    // Escat database
    escat_db                    = "${projectDir}/resources/escat_tiering.csv" // escat db. Check the provided file in the resources folder for the format

    // NMD database
    nmd_db                      = "${projectDir}/resources/nmd_final_grange.tsv" // nonsense mediated decay scores

    // CancerVar and InterVar
    cancervar_evidence_file     = "" // Add your own Evidence file for each Variant: evidence file as tab-delimited,format like this: Chr Pos Ref_allele Alt_allele  Evidence_list

    intervar_evidence_file      = "" // Add your own Evidence file for each Variant: evidence file as tab-delimited,format like this: Chr Pos Ref_allele Alt_allele  PM1=1;BS2=1;PP2=0

    // CNVKit
    cnvkit_cellularity          = "" // tumor purity
    cnvkit_threshold            = "-1.1,-0.4,0.3,0.7" // Hard thresholds for calling each integer copy number, separated by commas

    // renovo annotation
    renovo_path                 = "/software/renovo/" // path within singularity

    // cnv annotation
    classifyCNV_folder          = "/ClassifyCNV" // path within singularity

    // alpha missense
    // alpha_mis_genome_basedir    = "" // basedir containing alpha_missense/hg*/alphamissense_file, e.g. path2/public_databases
    alpha_missense               = null // file with alpha missense scores. If not provided, the default one provided in the resource directory will be used. Check the provided file in the resources folder for the format

    // civicpy
    skip_civic                  = false // set to true if you want to skip civicpy annotation
    civic_cache_timeout_days    = 9999 // set to 0 if you want to get the latest version of the civic db. Current is updated Dec. 18th 2024

    // filtering
    // filter_alpha_missense       = "likely_pathogenic,ambiguous" // alpha missense classification to keep; Available values: likely_pathogenic,ambiguous,likely_benign; it is an OR filter
    filter_cancervar            = "Tier_II_potential,Tier_I_strong" // comma separated list of cancervar classes to keep; Available values: Tier_II_potential,Tier_I_strong,Tier_III_Uncertain,Tier_IV_benign; it is an OR filter
    filter_civic_evidence_level = "A,B,C" // A till E; it is an OR filter. See https://civic.readthedocs.io/en/latest/model/evidence/level.html#:~:text=The%20evidence%20level%20describes%20the,%E2%80%9CE%20%2D%20Inferential%20association%E2%80%9D.
    filter_genes_germline       = null // file with list of Hugo_Symbol genes to be kept for germline sample; Each row is a gene. it is an AND filter.
    filter_genes_somatic        = null // file with list of Hugo_Symbol genes to be kept for somatic sample; Each row is a gene. it is an AND filter.
    filter_intervar             = "Pathogenic,Likely pathogenic" // comma separated list of intervar classes to keep; Available values: Pathogenic,Likely pathogenic,Uncertain significance,Likely benign,Benign; it is an OR filter
    filter_min_depth            = 50    // min depth to keep variant in the filtered variant output file; it is an AND filter
    filter_renovo               = "LP Pathogenic,IP Pathogenic,HP Pathogenic" // comma separated list of Renovo classes to keep; Available values: LP Pathogenic,IP Pathogenic,HP Pathogenic,LP Benign,IP Benign,HP Benign; it is an OR filter
    skip_pathogenic_retention   = false // set to true if you want to skip automatic retention of pathogenic variants
    filter_vaf_threshold        = 0.01  // min somatic variant allele frequency to keep the variant in the filtered variant output file; it is an AND filter
    filter_vaf_threshold_germline = 0.2 // min germline variant allele frequency to keep the variant in the filtered variant output file; it is an AND filter
    filter_var_classification   = "Silent,IGR,RNA" // Available options can be found in Variant Classification here: https://gatk.broadinstitute.org/hc/en-us/articles/360035531732-Funcotator-Annotation-Specifications
    filter_clinvar              = "Pathogenic,Likely pathogenic" // comma separated list of clinvar clinical significance to keep; it is an OR filter
    filter_escat                = "IA,IB,IC,IIA,IIB" // comma separated list of escat classes to keep; it is an OR filter

    // PostgreSQL database (optional - for caching annotations)
    pg_dsn                   = null // PostgreSQL DSN connection string (e.g., postgresql://user:pass@host:5432/dbname)
    pg_host                  = null // PostgreSQL host (alternative to DSN)
    pg_port                  = 5432 // PostgreSQL port (default: 5432)
    pg_user                  = null // PostgreSQL user (alternative to DSN)
    pg_password              = null // PostgreSQL password (alternative to DSN)
    pg_database              = null // PostgreSQL database name (alternative to DSN)
    
    technology              = "illumina" // illumina or iontorrent
    annovar_version         = "2020-02-19" // annovar version


    /**************************** Biomarkers parameters ****************************/

    // clonal tmb
    clonal_tmb_input            = null // input file format for clonal TMB calculation. Same input as described here (https://github.com/zhanyinx/clonal_evolution#input)

    // ascat
    // ascat_genome_basedir        = "" // basedir containing ascat_wes_files/hg*/*zip, e.g. path2/public_databases
    ascat_ploidy                = null  // default value for ASCAT
    ascat_min_base_qual         = 20    // default value for ASCAT
    ascat_min_counts            = 10    // default value for ASCAT
    ascat_min_map_qual          = 35    // default value for ASCAT
    ascat_purity                = null  // default value for ASCAT
    ascat_alleles               = null  // keep null if the database structure is the default one, provided from _insert_database_server_path_
    ascat_loci                  = null  // keep null if the database structure is the default one, provided from _insert_database_server_path_
    ascat_loci_gc               = null  // keep null if the database structure is the default one, provided from _insert_database_server_path_
    ascat_loci_rt               = null  // keep null if the database structure is the default one, provided from _insert_database_server_path_

    // mutational signature
    cosmic_group                = "${projectDir}/resources/cosmic_sbs_group.csv" // file with cosmic groups used to collapse SBSs. File with 2 columns: column 1 corresponds to group name, column 2 corresponds to the SBS number
    cosmic_version              = 3.4 // version of cosmic SBS.
    exome                       = true // set to true if exome sequencing data is used, false if whole genome sequencing data is used.

    // pyclone
    num_clusters                = 40    // Number of clusters to use in variational approximation distribution. Default is 40.
    num_restarts                = 20    // Number random restarts of Variational inference. Default is 20.

    // report
    cnv_genes_keep              = "${projectDir}/resources/cnv_genes.txt"  // file with Hugo_Symbol of genes to keep. No header is required. Each row is a gene

    // pharmgkb
    pharmgkb_hg38_fasta           = null  // path to hg38 fasta for pharmgkb liftover, downloaded from UCSC genome (https://hgdownload.gi.ucsc.edu/downloads.html). IMPORTANT: in the same directory as the .fa file there must also be the .fai and the .dict files (generated with samtools faidx and gatk CreateSequenceDictionary)
    pharmgkb_hg38_chain           = null  // path to chain file for liftover from hg19 to hg38 for pharmgkb variants, downloaded from UCSC genome (https://hgdownload.gi.ucsc.edu/downloads.html)
    skip_pharmgkb                 = false

}


/**************************** Profiles ****************************/
profiles {
    debug { process.beforeScript = "echo $HOSTNAME" }
    docker {
        docker.enabled         = true
        docker.userEmulation   = { params.use_gatk_spark ? false : true }.call()
        charliecloud.enabled   = false
        podman.enabled         = false
        shifter.enabled        = false
        singularity.enabled    = false
    }
    singularity {
        singularity.autoMounts = true
        singularity.enabled    = true
        charliecloud.enabled   = false
        docker.enabled         = false
        podman.enabled         = false
        shifter.enabled        = false
    }
}


/**************************** Manifest ****************************************************/

// The contract for `version` below — what the number names, who moves it, and when.
// It once sat at one value across six published releases, every one of them announcing
// itself as the first, because nothing said whose job the number was. This comment and
// the guard it names are what ended that.
//
// - It names the version this tree WILL be released as: the next release, not the last
//   one published. Between releases the manifest already carries the coming version.
// - It is the single source of truth. The codebase reads it in exactly one place
//   (lib/NfcoreTemplate.groovy, which derives the banner's rendering from it), the one
//   reader outside the pipeline is tools/manifest_version.py, and no other file may state
//   a pipeline version: .github/workflows/version-contract.yml fails any push or pull
//   request that adds one, in this repository and in the public one, which receives this
//   file verbatim.
// - Three components, compared as exact strings — no normalising, no shortened spellings.
// - The release tag is the fixed text "variantalker-v" followed by this exact value; the
//   workflow's tag job refuses a tag naming anything else. The prefix reads like
//   manifest.name but is deliberately not derived from it: rewording the display label
//   must not move the tag namespace.
// - Only the release act moves it, and the act ends by bumping it to the next target —
//   the guard refuses a tree that sits on a version already tagged elsewhere. The number
//   only ever moves forward; the guard checks reuse, not direction, so "forward" is this
//   contract's rule, kept by procedure rather than CI.
// - It is unrelated to MAFigate's APP_VERSION (streamlit_app/config/constants.py):
//   bumping either never implies bumping the other, and what pipeline a MAFigate build
//   works with is a separate claim, not a version comparison.
//
// Release history, and how this number relates to the repository's earlier bare-numbered
// releases: CHANGELOG.md.
manifest {
    name            = "variantalker"
    author          = """Yinxiu Zhan, Bastian Eichenberger"""
    homePage        = "https://github.com/zhanyinx/variantalker"
    description     = """Variant annotation pipeline."""
    mainScript      = "main.nf"
    nextflowVersion = "!>=22.10.1"
    version         = "1.2.0"
}

/**************************** Configs ****************************************************/
includeConfig "config/biomarkers.config"
includeConfig "config/base.config"
includeConfig "config/annotation.config"

/**************************** Tower ****************************************************/
tower {
    enabled = false
}




// Function to ensure that resource requirements don"t go beyond
// a maximum limit
def check_max(obj, type){
    if (type == "memory") {
        try {
            if (obj.compareTo(params.max_memory as nextflow.util.MemoryUnit) == 1)
                return params.max_memory as nextflow.util.MemoryUnit
            else
                return obj
        } catch (all) {
            println "   ### ERROR ###   Max memory '${params.max_memory}' is not valid! Using default value: $obj"
            return obj
        }
    } else if (type == "time") {
        try {
            if (obj.compareTo(params.max_time as nextflow.util.Duration) == 1)
                return params.max_time as nextflow.util.Duration
            else
                return obj
        } catch (all) {
            println "   ### ERROR ###   Max time '${params.max_time}' is not valid! Using default value: $obj"
            return obj
        }
    } else if (type == "cpus") {
        try {
            return Math.min( obj, params.max_cpus as int )
        } catch (all) {
            println "   ### ERROR ###   Max cpus '${params.max_cpus}' is not valid! Using default value: $obj"
            return obj
        }
    }
}
